{
  "damage_times_heads": {
    "params": { "coins": "int" },
    "steps": [
      {"call": "flip_coins", "args": {"count": "$coins"}, "as": "heads"},
      {"call": "attack_damage", "args": {"times": "$heads", "plus": 0}}
    ]
  },
  "damage_times_heads_per_own_energy_unit": {
    "params": {},
    "steps": [
      {"call": "count_attached_energy_units", "args": {"target": "$self", "energy_type": "Any"}, "as": "energy"},
      {"call": "damage_times_heads", "args": {"coins": "$energy"}}
    ]
  },
  "damage_plus_on_heads": {
    "params": { "coins": "int", "bonus_per_heads": "int" },
    "steps": [
      {"call": "flip_coins", "args": {"count": "$coins"}, "as": "heads"},
      {"call": "multiply", "args": {"a": "$heads", "b": "$bonus_per_heads"}, "as": "bonus"},
      {"call": "attack_damage", "args": {"times": 1, "plus": "$bonus"}}
    ]
  },
  "damage_self": {
    "params": { "amount": "int" },
    "steps": [
      {"call": "direct_damage", "args": {"target": "$self", "amount": "$amount"}}
    ]
  },
  "damage_then_damage_self": {
    "params": { "amount": "int" },
    "steps": [
      {"call": "attack_damage", "args": {"times": 1, "plus": 0}},
      {"call": "damage_self", "args": {"amount": "$amount"}}
    ]
  },
  "damage_then_damage_self_on_tails": {
    "params": { "amount": "int" },
    "steps": [
      {"call": "flip_coins", "args": {"count": 1}, "as": "heads"},
      {"call": "attack_damage", "args": {"times": 1, "plus": 0}},
      {"call": "damage_self", "args": {"amount": "$amount"}, "when": {"value": "$heads", "eq": 0}}
    ]
  },
  "damage_plus_on_heads_or_damage_self": {
    "params": { "bonus": "int", "self_damage": "int" },
    "steps": [
      {"call": "flip_coins", "args": {"count": 1}, "as": "heads"},
      {"call": "multiply", "args": {"a": "$heads", "b": "$bonus"}, "as": "extra"},
      {"call": "attack_damage", "args": {"times": 1, "plus": "$extra"}},
      {"call": "damage_self", "args": {"amount": "$self_damage"}, "when": {"value": "$heads", "eq": 0}}
    ]
  },
  "damage_plus_per_counter": {
    "params": { "target": "pokemon", "per_counter": "int" },
    "steps": [
      {"call": "count_damage_counters", "args": {"target": "$target"}, "as": "counters"},
      {"call": "multiply", "args": {"a": "$counters", "b": "$per_counter"}, "as": "bonus"},
      {"call": "attack_damage", "args": {"times": 1, "plus": "$bonus"}}
    ]
  },
  "damage_plus_per_own_counter": {
    "params": { "per_counter": "int" },
    "steps": [
      {"call": "damage_plus_per_counter", "args": {"target": "$self", "per_counter": "$per_counter"}}
    ]
  },
  "damage_plus_per_defender_counter": {
    "params": { "per_counter": "int" },
    "steps": [
      {"call": "damage_plus_per_counter", "args": {"target": "$defender", "per_counter": "$per_counter"}}
    ]
  },
  "damage_minus_per_own_counter": {
    "params": { "per_counter": "int" },
    "steps": [
      {"call": "multiply", "args": {"a": "$per_counter", "b": -1}, "as": "negative"},
      {"call": "damage_plus_per_counter", "args": {"target": "$self", "per_counter": "$negative"}}
    ]
  },
  "damage_times_own_counters": {
    "params": {},
    "steps": [
      {"call": "count_damage_counters", "args": {"target": "$self"}, "as": "counters"},
      {"call": "attack_damage", "args": {"times": "$counters", "plus": 0}}
    ]
  },
  "damage_plus_per_own_benched": {
    "params": { "per_benched": "int" },
    "steps": [
      {"call": "count_benched", "args": {"player": "$player"}, "as": "benched"},
      {"call": "multiply", "args": {"a": "$benched", "b": "$per_benched"}, "as": "bonus"},
      {"call": "attack_damage", "args": {"times": 1, "plus": "$bonus"}}
    ]
  },
  "damage_plus_per_unpaid_energy_unit": {
    "params": { "energy_type": "energy_type_or_any", "per_energy": "int", "max_counted": "int" },
    "steps": [
      {"call": "count_unpaid_energy_units", "args": {"energy_type": "$energy_type"}, "as": "unpaid"},
      {"call": "min", "args": {"a": "$unpaid", "b": "$max_counted"}, "as": "counted"},
      {"call": "multiply", "args": {"a": "$counted", "b": "$per_energy"}, "as": "bonus"},
      {"call": "attack_damage", "args": {"times": 1, "plus": "$bonus"}}
    ]
  },
  "damage_plus_per_defender_energy_card": {
    "params": { "per_energy": "int" },
    "steps": [
      {"call": "count_attached_energy_cards", "args": {"target": "$defender", "energy_type": "Any"}, "as": "energy"},
      {"call": "multiply", "args": {"a": "$energy", "b": "$per_energy"}, "as": "bonus"},
      {"call": "attack_damage", "args": {"times": 1, "plus": "$bonus"}}
    ]
  },
  "discard_own_energy_cards": {
    "params": { "energy_type": "energy_type_or_any", "count": "int" },
    "requires": [
      {"check": "has_attached_energy_cards", "args": {"target": "$self", "energy_type": "$energy_type", "count": "$count"}}
    ],
    "steps": [
      {"call": "discard_attached_energy_cards", "args": {"target": "$self", "energy_type": "$energy_type", "count": "$count"}}
    ]
  },
  "discard_energy_cards_then_damage": {
    "params": { "energy_type": "energy_type_or_any", "count": "int" },
    "steps": [
      {"call": "discard_own_energy_cards", "args": {"energy_type": "$energy_type", "count": "$count"}},
      {"call": "attack_damage", "args": {"times": 1, "plus": 0}}
    ]
  },
  "discard_all_energy_cards_then_damage": {
    "params": {},
    "steps": [
      {"call": "discard_all_attached_energy_cards", "args": {"target": "$self"}},
      {"call": "attack_damage", "args": {"times": 1, "plus": 0}}
    ]
  },
  "draw": {
    "params": { "count": "int" },
    "steps": [
      {"call": "draw_cards", "args": {"player": "$player", "count": "$count"}}
    ]
  },
  "damage_then_draw_on_heads": {
    "params": { "count": "int" },
    "steps": [
      {"call": "flip_coins", "args": {"count": 1}, "as": "heads"},
      {"call": "attack_damage", "args": {"times": 1, "plus": 0}},
      {"call": "draw", "args": {"count": "$count"}, "when": {"value": "$heads", "eq": 1}}
    ]
  },
  "switch_own_active": {
    "params": {},
    "requires": [
      {"check": "has_benched", "args": {"player": "$player", "count": 1}}
    ],
    "steps": [
      {"call": "switch_in", "args": {"player": "$player", "chooser": "$player"}}
    ]
  },
  "switch_opponent_active": {
    "params": {},
    "requires": [
      {"check": "has_benched", "args": {"player": "$opponent", "count": 1}}
    ],
    "steps": [
      {"call": "switch_in", "args": {"player": "$opponent", "chooser": "$player"}}
    ]
  },
  "shuffle_hand_then_draw": {
    "params": { "count": "int" },
    "steps": [
      {"call": "shuffle_hand_into_deck", "args": {"player": "$player"}},
      {"call": "draw", "args": {"count": "$count"}}
    ]
  },
  "search_deck_to_hand": {
    "params": { "filter": "card_filter", "count": "int" },
    "requires": [
      {"check": "has_cards_in_deck", "args": {"player": "$player", "count": 1}}
    ],
    "steps": [
      {"call": "search_deck", "args": {"player": "$player", "filter": "$filter", "count": "$count"}}
    ]
  },
  "recover_from_discard": {
    "params": { "filter": "card_filter", "count": "int" },
    "requires": [
      {"check": "has_cards_in_discard", "args": {"player": "$player", "filter": "$filter", "count": 1}}
    ],
    "steps": [
      {"call": "take_from_discard", "args": {"player": "$player", "filter": "$filter", "count": "$count"}}
    ]
  },
  "discard_opponent_energy_on_heads": {
    "params": { "filter": "card_filter", "count": "int" },
    "requires": [
      {"check": "has_energy_in_play", "args": {"player": "$opponent", "filter": "$filter", "count": 1}}
    ],
    "steps": [
      {"call": "flip_coins", "args": {"count": 1}, "as": "heads"},
      {"call": "discard_energy_in_play", "args": {"player": "$opponent", "chooser": "$player", "filter": "$filter", "count": "$count"}, "when": {"value": "$heads", "eq": 1}}
    ]
  },
  "damage_to_opponent_benched": {
    "params": { "amount": "int" },
    "steps": [
      {"call": "attack_damage_to_benched", "args": {"player": "$opponent", "amount": "$amount"}}
    ]
  },
  "damage_then_switch_self": {
    "params": {},
    "steps": [
      {"call": "attack_damage", "args": {"times": 1, "plus": 0}},
      {"call": "switch_in", "args": {"player": "$player", "chooser": "$player"}}
    ]
  },
  "damage_then_pay_tp_to_heal_benched": {
    "params": { "tp": "int", "heal": "int" },
    "steps": [
      {"call": "attack_damage", "args": {"times": 1, "plus": 0}},
      {"call": "pay_tp", "args": {"player": "$player", "amount": "$tp"}, "as": "paid"},
      {"call": "heal_benched", "args": {"player": "$player", "amount": "$heal"}, "when": {"value": "$paid", "eq": 1}}
    ]
  },
  "damage_plus_with_energy_units_then_shuffle_energy": {
    "params": { "min_units": "int", "bonus": "int" },
    "steps": [
      {"call": "count_attached_energy_units", "args": {"target": "$self", "energy_type": "Any"}, "as": "units"},
      {"call": "at_least", "args": {"a": "$units", "b": "$min_units"}, "as": "met"},
      {"call": "multiply", "args": {"a": "$met", "b": "$bonus"}, "as": "extra"},
      {"call": "attack_damage", "args": {"times": 1, "plus": "$extra"}},
      {"call": "shuffle_attached_energy_into_deck", "args": {"target": "$self"}}
    ]
  },
  "damage_times_same_name_in_play": {
    "params": {},
    "steps": [
      {"call": "count_same_name_in_play", "args": {"target": "$self"}, "as": "copies"},
      {"call": "attack_damage", "args": {"times": "$copies", "plus": 0}}
    ]
  },
  "counters_on_self_then_attach_from_discard_to_benched": {
    "params": { "counters": "int", "filter": "card_filter" },
    "requires": [
      {"check": "has_cards_in_discard", "args": {"player": "$player", "filter": "$filter", "count": 1}},
      {"check": "has_benched", "args": {"player": "$player", "count": 1}}
    ],
    "steps": [
      {"call": "place_damage_counters", "args": {"target": "$self", "count": "$counters"}},
      {"call": "attach_from_discard_to_benched", "args": {"player": "$player", "filter": "$filter"}}
    ]
  },
    "counters_on_attack_damaged_on_heads": {
    "params": { "counters": "int" },
    "steps": [
      {"call": "flip_coins", "args": {"count": 1}, "as": "heads"},
      {"call": "place_damage_counters_on_attack_damaged", "args": {"count": "$counters"}, "when": {"value": "$heads", "eq": 1}}
    ]
  },
  "search_deck_to_discard_pile": {
    "params": { "filter": "card_filter", "count": "int" },
    "requires": [
      {"check": "has_cards_in_deck", "args": {"player": "$player", "count": 1}}
    ],
    "steps": [
      {"call": "search_deck_to_discard", "args": {"player": "$player", "filter": "$filter", "count": "$count"}}
    ]
  },
  "discard_hand_then_search_deck": {
    "params": { "filter": "card_filter", "count": "int" },
    "requires": [
      {"check": "has_cards_in_deck", "args": {"player": "$player", "count": 1}}
    ],
    "steps": [
      {"call": "discard_hand", "args": {"player": "$player"}},
      {"call": "search_deck", "args": {"player": "$player", "filter": "$filter", "count": "$count"}}
    ]
  },
  "discard_from_hand_then_search_deck": {
    "params": { "discard": "int", "filter": "card_filter", "count": "int" },
    "requires": [
      {"check": "has_cards_in_hand", "args": {"player": "$player", "filter": ["any"], "count": "$discard"}},
      {"check": "has_cards_in_deck", "args": {"player": "$player", "count": 1}}
    ],
    "steps": [
      {"call": "discard_from_hand", "args": {"player": "$player", "filter": ["any"], "count": "$discard"}},
      {"call": "search_deck", "args": {"player": "$player", "filter": "$filter", "count": "$count"}}
    ]
  },
  "both_hands_to_bottom_of_deck_then_draw": {
    "params": { "count": "int" },
    "steps": [
      {"call": "put_hand_on_bottom_of_deck", "args": {"player": "$player"}},
      {"call": "put_hand_on_bottom_of_deck", "args": {"player": "$opponent"}},
      {"call": "draw_cards", "args": {"player": "$player", "count": "$count"}},
      {"call": "draw_cards", "args": {"player": "$opponent", "count": "$count"}}
    ]
  },
  "damage_then_search_deck": {
    "params": { "filter": "card_filter", "count": "int" },
    "steps": [
      {"call": "attack_damage", "args": {"times": 1, "plus": 0}},
      {"call": "search_deck", "args": {"player": "$player", "filter": "$filter", "count": "$count"}}
    ]
  },
  "damage_then_attach_from_hand_to_benched": {
    "params": { "filter": "card_filter" },
    "steps": [
      {"call": "attack_damage", "args": {"times": 1, "plus": 0}},
      {"call": "attach_from_hand_to_benched", "args": {"player": "$player", "filter": "$filter"}}
    ]
  },
  "damage_plus_per_type_on_own_bench": {
    "params": { "per_type": "int" },
    "steps": [
      {"call": "count_types_on_bench", "args": {"player": "$player"}, "as": "types"},
      {"call": "multiply", "args": {"a": "$types", "b": "$per_type"}, "as": "bonus"},
      {"call": "attack_damage", "args": {"times": 1, "plus": "$bonus"}}
    ]
  },
  "discard_own_energy_then_counters_with_extra_turn_on_knockout": {
    "params": { "counters": "int" },
    "requires": [
      {"check": "attack_not_used_last_turn", "args": {"player": "$player"}}
    ],
    "steps": [
      {"call": "discard_all_attached_energy_cards", "args": {"target": "$self"}},
      {"call": "choose_darkner", "args": {"player": "$opponent", "chooser": "$player"}, "as": "target"},
      {"call": "place_damage_counters", "args": {"target": "$target", "count": "$counters"}},
      {"call": "is_knocked_out", "args": {"target": "$target"}, "as": "knocked_out"},
      {"call": "take_extra_turn", "args": {}, "when": {"value": "$knocked_out", "eq": 1}}
    ]
  },
  "discard_from_hand_then_draw": {
    "params": { "filter": "card_filter", "discard": "int", "draw": "int" },
    "requires": [
      {"check": "has_cards_in_hand", "args": {"player": "$player", "filter": "$filter", "count": "$discard"}}
    ],
    "steps": [
      {"call": "discard_from_hand", "args": {"player": "$player", "filter": "$filter", "count": "$discard"}},
      {"call": "draw_cards", "args": {"player": "$player", "count": "$draw"}}
    ]
  },
  "search_deck_onto_field": {
    "params": { "filter": "card_filter", "count": "int", "exclude_same_name": "int" },
    "requires": [
      {"check": "has_cards_in_deck", "args": {"player": "$player", "count": 1}},
      {"check": "has_room_on_field", "args": {"player": "$player", "count": 1}}
    ],
    "steps": [
      {"call": "search_deck_to_bench", "args": {"player": "$player", "filter": "$filter", "count": "$count", "exclude_same_name": "$exclude_same_name"}}
    ]
  },
  "both_shuffle_hands_then_draw": {
    "params": { "count": "int" },
    "requires": [
      {"check": "not_first_turn", "args": {"player": "$player"}}
    ],
    "steps": [
      {"call": "shuffle_hand_into_deck", "args": {"player": "$player"}},
      {"call": "shuffle_hand_into_deck", "args": {"player": "$opponent"}},
      {"call": "draw_cards", "args": {"player": "$player", "count": "$count"}},
      {"call": "draw_cards", "args": {"player": "$opponent", "count": "$count"}}
    ]
  },
  "prevent_attack_damage_to_own_bench": {
    "params": {},
    "requires": [
      {"check": "in_battle_zone", "args": {"target": "$self"}}
    ],
    "steps": [
      {"call": "prevent_attack_damage_to_bench", "args": {"player": "$player"}}
    ]
  },
  "counters_on_subject": {
    "params": { "counters": "int" },
    "steps": [
      {"call": "place_damage_counters", "args": {"target": "$subject", "count": "$counters"}}
    ]
  }
}